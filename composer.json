{
    "name": "bluetree-service/register",
    "description": "Basic Register pattern class",
    "keywords": ["register"],
    "license": "Apache-2.0",
    "type": "library",
    "authors": [
        {
            "name": "Michał Adamiak",
            "email": "chajr@bluetree.pl",
            "homepage": "https://github.com/chajr",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "bluetree-service/event": "^0.10.0",
        "bluetree-service/simple-log": "^0.10.0"
    },
    "autoload": {
        "psr-4": {
            "BlueRegister\\": "src/"
        }
    },
    "autoload-dev": {
        "classmap": [
            "tests"
        ]
    },
    "scripts": {
        "test": "./vendor/bin/phpunit --display-warnings",
        "coverage": "./vendor/bin/phpunit --display-warnings --coverage-clover build/logs/clover.xml",
        "clover-report": "./vendor/bin/clover_reporter -c build/logs/clover.xml",
        "clover-full": "./vendor/bin/clover_reporter -f build/logs/clover.xml",
        "clover-html": "./vendor/bin/clover_reporter -P ./build/report.html -f -H build/logs/clover.xml",
        "test-complete": [
            "@coverage",
            "@clover-html"
        ]
    },
    "require-dev": {
        "bluetree-service/clover-reporter": "^0.3.2",
        "phpunit/phpunit": "^11.5",
        "symfony/filesystem": "^7.4",
        "symfony/console": "^7.4"
    }
}
